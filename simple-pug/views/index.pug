//- The whole app is this one page.

doctype html
html
  head
    title My Todos
    style.
      body { font-family: sans-serif; max-width: 400px; margin: 40px auto;
             line-height: 1.8; }
      .done { color: #999; text-decoration: line-through; }
      span { margin: 0 8px; }
      form.row { display: flex; gap: 8px; }
      input { flex: 1; padding: 6px; }

  body
    h1 My Todos

    //- the form that adds a new todo
    form.row(action="/add", method="POST")
      input(type="text", name="text", placeholder="What needs doing?")
      button(type="submit") Add

    //- one line per todo
    each todo, i in todos
      p
        //- the tick button, and a line-through style when it is done
        form(action="/done/" + i, method="POST", style="display:inline")
          button(type="submit")= todo.done ? 'Undo' : 'Done'

        if todo.done
          span.done= todo.text
        else
          span= todo.text

        form(action="/delete/" + i, method="POST", style="display:inline")
          button(type="submit") x
    else
      p Nothing to do.
