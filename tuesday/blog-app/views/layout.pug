//- layout.pug - the page frame that every other view reuses.
//- Lines starting with //- are Pug comments.

doctype html
html
  head
    title= title
    style.
      body { font-family: sans-serif; max-width: 600px; margin: 40px auto;
             line-height: 1.6; }
      a { text-decoration: none; }
      input, textarea { width: 100%; padding: 6px; }

  body
    h1
      a(href="/") My Blog
    a(href="/new") Write a post
    hr

    //- each page puts its own content here
    block content
